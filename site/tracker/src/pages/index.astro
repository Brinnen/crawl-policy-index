---
import Layout from "../layouts/Layout.astro";
import NamedChart from "../components/NamedChart.astro";
import Stat from "../components/Stat.astro";
import Glossary from "../components/Glossary.astro";
import lab from "../data/lab.json";
import { purposeLabel } from "../lib/labels";

const s = lab.summary;
const agents = lab.by_agent ?? [];
const n = (value: number) => new Intl.NumberFormat("en-US").format(value);
const dash = (value: number | null | undefined) =>
  value === null || value === undefined ? "—" : n(value);
---
<Layout title="Crawl Policy Index">
  <section class="hero">
    <div class="hero-copy">
      <p class="pill"><i></i> Early look · 1,000 test sites</p>
      <h1>Which websites allow AI to read them?</h1>
      <p class="lede">
        Sites post public rules about automated visitors. We check those rules every day
        and show who they named — ChatGPT, Claude, and others — and whether they said
        yes, no, or it depends.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/data">Browse the tables</a>
        <a class="btn btn-ghost" href="/methodology">How we count</a>
      </div>
    </div>
    <aside class="instrument">
      <p class="instrument-label">Sites that named GPTBot</p>
      <p class="instrument-sub">
        GPTBot is OpenAI’s crawler for training ChatGPT. We only count sites that wrote
        that name. A blanket “block all bots” rule is not included here.
      </p>
      <NamedChart
        block={s.gptbot_named_block}
        allow={s.gptbot_named_allow}
        partial={s.gptbot_named_partial}
      />
    </aside>
  </section>

  <section class="stats">
    <Stat
      label="Readable rule files"
      value={n(s.trusted_robots)}
      hint={`Of ${n(1000)} test sites`}
    />
    <Stat
      label="Named and blocked GPTBot"
      value={n(s.gptbot_named_block)}
      hint="Wrote the name and said no"
    />
    <Stat
      label="Counting Amazon once"
      value={n(s.gptbot_named_block_grouped)}
      hint="Country shops treated as one company"
    />
    <Stat
      label="Training no, search yes"
      value={n(s.openai_split)}
      hint="Blocked GPTBot, still allow OpenAI search"
    />
  </section>

  <section class="grid-3">
    <article class="tile">
      <h3>Journalists</h3>
      <p>Compare what publishers and platforms actually wrote — without opening hundreds of technical files.</p>
    </article>
    <article class="tile">
      <h3>Researchers</h3>
      <p>The same list of sites, checked the same way, every day. This is a record of rules, not a traffic report.</p>
    </article>
    <article class="tile">
      <h3>Marketing &amp; policy</h3>
      <p>See who is closing the door on training while still allowing AI search — and who is doing both.</p>
    </article>
  </section>

  <section class="panel">
    <h2>How many sites named each bot?</h2>
    <p class="sub">
      Click a name to open the tables. More companies (Claude, Common Crawl, and others)
      appear after the next data refresh.
    </p>
    <table class="data">
      <thead>
        <tr>
          <th>Bot</th>
          <th>Company</th>
          <th>What it’s for</th>
          <th class="num">Blocked</th>
          <th class="num">Allowed</th>
          <th class="num">Mixed</th>
        </tr>
      </thead>
      <tbody>
        {agents.map((row) => (
          <tr>
            <td><a href={`/data?agent=${row.slug}`}>{row.token}</a></td>
            <td>{row.operator}</td>
            <td>{purposeLabel(row.purpose)}</td>
            <td class="num">{dash(row.named_block)}</td>
            <td class="num">{dash(row.named_allow)}</td>
            <td class="num">{dash(row.named_partial)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <Glossary />
</Layout>
