---
import Layout from "../layouts/Layout.astro";
import LookupForm from "../components/LookupForm.astro";
import Overnight from "../components/Overnight.astro";
import SiteCard from "../components/SiteCard.astro";
import { HISTORY_PRICE_LABEL, PRICE_LABEL } from "../lib/access";
import { agents, previewPack } from "../lib/lookupPack";
import { FAMOUS_SITES, buildSiteView } from "../lib/story";
import lab from "../data/lab.json";

const panel = Number(lab.summary.panel_size || 100000).toLocaleString("en-US");
const pack = previewPack();
const famous = FAMOUS_SITES.map((host) => buildSiteView(host, pack, agents())).filter(
  (view): view is NonNullable<typeof view> => Boolean(view),
);

let digest: {
  as_of?: string;
  blocked?: number;
  unblocked?: number;
  named?: number;
  changed?: number;
  items?: { date: string; domain: string; agent: string; kind: string }[];
} | null = null;
try {
  const digestUrl =
    import.meta.env.CPI_DIGEST_URL || "http://178.128.255.20/snapshot/digest.json";
  const res = await fetch(digestUrl, { signal: AbortSignal.timeout(4000) });
  if (res.ok) digest = await res.json();
} catch {
  digest = null;
}
---
<Layout
  title="What does this website tell AI crawlers?"
  description="Look up a website. We'll say in English who it blocks — GPTBot, Claude, Google, and the rest."
>
  <section class="hero hero-sell">
    <div class="hero-copy">
      <p class="pill"><i></i> Public crawl rules, in English</p>
      <h1>What does this website tell AI crawlers?</h1>
      <p class="lede">
        Type a name you already know. We read its robots.txt every day — the public file that
        says which bots may look around — and we say it so a person can repeat it.
      </p>
      <LookupForm autofocus={true} />
    </div>
  </section>

  <Overnight digest={digest} />

  <section class="famous" id="famous">
    <p class="kicker">Sites you already know</p>
    <h2>A wall of names. One sentence each.</h2>
    <p class="sub">
      Same reading as the full list of {panel}. These are just the ones you can picture.
    </p>
    <div class="famous-grid">
      {famous.map((view) => (
        <SiteCard view={view} compact={true} />
      ))}
    </div>
  </section>

  <div class="paywall-band">
    <p>
      Want every site, the filters, and a file? Full table {PRICE_LABEL}.
      Who flipped, and when — {HISTORY_PRICE_LABEL}.
    </p>
    <a class="btn btn-primary" href="/pricing">Subscribe</a>
  </div>
</Layout>
