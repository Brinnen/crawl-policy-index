---
import Layout from "../layouts/Layout.astro";
import NamedChart from "../components/NamedChart.astro";
import Stat from "../components/Stat.astro";
import lab from "../data/lab.json";

const s = lab.summary;
const agents = lab.by_agent ?? [];
const n = (value: number) => new Intl.NumberFormat("en-US").format(value);
const dash = (value: number | null | undefined) =>
  value === null || value === undefined ? "—" : n(value);
const purpose: Record<string, string> = {
  training: "Training",
  search_index: "Search",
  user_fetch: "User fetch",
  opt_out_token: "Opt-out token",
  agentic: "Agentic",
  unknown: "Unknown",
};
---
<Layout title="Crawl Policy Index">
  <section class="hero">
    <div class="hero-copy">
      <p class="pill"><i></i> Live fetch · lab panel</p>
      <h1>The market for permission to crawl.</h1>
      <p class="lede">
        Daily, site-declared AI crawl policy — who each domain allows, blocks, or splits
        between training and search. Built as a longitudinal index, not a traffic panel.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/data">Open the explorer</a>
        <a class="btn btn-ghost" href="/methodology">Read the contract</a>
      </div>
    </div>
    <aside class="instrument">
      <p class="instrument-label">Named GPTBot posture</p>
      <p class="instrument-sub">Explicit rules only. Wildcard <code>*</code> inheritance is excluded.</p>
      <NamedChart
        block={s.gptbot_named_block}
        allow={s.gptbot_named_allow}
        partial={s.gptbot_named_partial}
      />
    </aside>
  </section>

  <section class="stats">
    <Stat label="Trusted robots.txt" value={n(s.trusted_robots)} hint="Open wildcard intervals" />
    <Stat label="Named GPTBot block" value={n(s.gptbot_named_block)} hint="Explicit rules only" />
    <Stat label="After amazon.*" value={n(s.gptbot_named_block_grouped)} hint="Country sites collapsed" />
    <Stat label="Training / search split" value={n(s.openai_split)} hint="Block GPTBot, search not blocked" />
  </section>

  <section class="grid-3">
    <article class="tile">
      <h3>Publishers</h3>
      <p>See whether peers named training crawlers, search crawlers, or both — and when that changed.</p>
    </article>
    <article class="tile">
      <h3>Model labs</h3>
      <p>A frozen panel and a parse you can replay. Not a scrape of page text. Not a traffic estimate.</p>
    </article>
    <article class="tile">
      <h3>Counsel &amp; policy</h3>
      <p>Every figure traces to a SQL view over one panel version and one parse version. Or it does not ship.</p>
    </article>
  </section>

  <section class="panel">
    <h2>Named rules by agent</h2>
    <p class="sub">Same explicit-only rule as the explorer. Claude, Grok, and the rest show up here once the next warehouse export includes them.</p>
    <table class="data">
      <thead>
        <tr>
          <th>Agent</th>
          <th>Operator</th>
          <th>Purpose</th>
          <th class="num">Block</th>
          <th class="num">Allow</th>
          <th class="num">Partial</th>
        </tr>
      </thead>
      <tbody>
        {agents.map((row) => (
          <tr>
            <td><a href={`/data?agent=${row.slug}`} class="mono">{row.token}</a></td>
            <td>{row.operator}</td>
            <td>{purpose[row.purpose] ?? row.purpose}</td>
            <td class="num">{dash(row.named_block)}</td>
            <td class="num">{dash(row.named_allow)}</td>
            <td class="num">{dash(row.named_partial)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
</Layout>
