---
import Layout from "../layouts/Layout.astro";
import NamedChart from "../components/NamedChart.astro";
import Stat from "../components/Stat.astro";
import lab from "../data/lab.json";

const s = lab.summary;
const namedBlocks = lab.named.filter((r) => r.state === "BLOCKED");
const n = (value: number) => new Intl.NumberFormat("en-US").format(value);
---
<Layout title="Crawl Policy Index">
  <section class="hero">
    <div class="hero-copy">
      <p class="pill"><i></i> Live fetch · lab panel</p>
      <h1>The market for permission to crawl.</h1>
      <p class="lede">
        Daily, site-declared AI crawl policy — who each domain allows, blocks, or splits
        between training and search. Built as a longitudinal index, not a traffic panel.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/data">Get the lab snapshot</a>
        <a class="btn btn-ghost" href="/methodology">Read the contract</a>
      </div>
    </div>
    <aside class="instrument">
      <p class="instrument-label">Named GPTBot posture</p>
      <p class="instrument-sub">Explicit rules only. Wildcard <code>*</code> inheritance is excluded.</p>
      <NamedChart
        block={s.gptbot_named_block}
        allow={s.gptbot_named_allow}
        partial={s.gptbot_named_partial}
      />
    </aside>
  </section>

  <section class="stats">
    <Stat label="Trusted robots.txt" value={n(s.trusted_robots)} hint="Open wildcard intervals" />
    <Stat label="Named GPTBot block" value={n(s.gptbot_named_block)} hint="Explicit rules only" />
    <Stat label="After amazon.*" value={n(s.gptbot_named_block_grouped)} hint="Country sites collapsed" />
    <Stat label="Training / search split" value={n(s.openai_split)} hint="Block GPTBot, search not blocked" />
  </section>

  <section class="grid-3">
    <article class="tile">
      <h3>Publishers</h3>
      <p>See whether peers named training crawlers, search crawlers, or both — and when that changed.</p>
    </article>
    <article class="tile">
      <h3>Model labs</h3>
      <p>A frozen panel and a parse you can replay. Not a scrape of page text. Not a traffic estimate.</p>
    </article>
    <article class="tile">
      <h3>Counsel &amp; policy</h3>
      <p>Every figure traces to a SQL view over one panel version and one parse version. Or it does not ship.</p>
    </article>
  </section>

  <section class="panel">
    <h2>Lab readout</h2>
    <p class="sub">Same warehouse view as the chart. Sanity: named Googlebot blocks should stay near zero.</p>
    <table class="data">
      <thead>
        <tr>
          <th>Measure</th>
          <th class="num">N</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Calendar robots observations</td>
          <td class="num">{n(s.calendar_observations)}</td>
        </tr>
        <tr>
          <td>Named GPTBot allow / partial</td>
          <td class="num">{n(s.gptbot_named_allow)} / {n(s.gptbot_named_partial)}</td>
        </tr>
        <tr>
          <td>Named Googlebot block</td>
          <td class="num">{n(s.googlebot_named_block)}</td>
        </tr>
      </tbody>
    </table>
  </section>

  {namedBlocks.length > 0 ? (
    <section class="panel">
      <h2>Named GPTBot blocks</h2>
      <p class="sub">{namedBlocks.length} domains. Amazon country sites listed separately; grouped count is in the hero stats.</p>
      <table class="data">
        <thead>
          <tr>
            <th>Domain</th>
            <th>Group</th>
          </tr>
        </thead>
        <tbody>
          {namedBlocks.map((row) => (
            <tr>
              <td><a href={`/domain/${row.domain}`}>{row.domain}</a></td>
              <td class="mono">{row.group_key}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  ) : (
    <section class="empty">
      <h2>Domain directory next</h2>
      <p>Named-domain rows appear after the next warehouse export is committed. Snapshot totals above are already live from <code>{lab.view}</code>.</p>
    </section>
  )}
</Layout>
