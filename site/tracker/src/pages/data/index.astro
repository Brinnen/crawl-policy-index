---
import Layout from "../../layouts/Layout.astro";
import { purposeLabel } from "../../lib/labels";
import { PRICE_LABEL } from "../../lib/access";
import lab from "../../data/lab.json";

const agents = (lab.by_agent ?? []).slice(0, 8);
---
<Layout
  title="Bots — Crawl Policy Index"
  description="How often each AI crawler is named and blocked on this list of sites."
>
  <div class="page-head">
    <p class="kicker">Bots</p>
    <h1>A preview of who is named and blocked.</h1>
  </div>
  <p class="lede">
    Top bots on this list. Country, type, language, and the rest of the sites are in the full table.
  </p>
  <section class="panel">
    <div class="table-scroll">
      <table class="data">
        <thead>
          <tr>
            <th>Bot</th>
            <th>Company</th>
            <th>What it’s for</th>
            <th class="num">Blocked</th>
          </tr>
        </thead>
        <tbody>
          {agents.map((row) => (
            <tr>
              <td>{row.token}</td>
              <td>{row.operator}</td>
              <td>{purposeLabel(row.purpose)}</td>
              <td class="num">{row.named_block ?? "—"}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="paywall-band">
      <p>Want every bot, every site, and the filters? Subscribe today.</p>
      <a class="btn btn-primary" href="/pricing">Subscribe · {PRICE_LABEL}</a>
    </div>
  </section>
</Layout>
