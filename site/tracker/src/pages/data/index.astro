---
import Layout from "../../layouts/Layout.astro";
import Explorer from "../../components/Explorer.astro";
import lab from "../../data/lab.json";

const agents = lab.by_agent ?? [];
const named = lab.named ?? [];
---
<Layout
  title="Explorer — Crawl Policy Index"
  description="Filter named AI crawl rules by agent, operator, purpose, and domain. Lab preview — not a published series."
>
  <div class="page-head">
    <p class="kicker">Explorer</p>
    <h1>Named rules, sliced your way.</h1>
  </div>
  <p class="lede">
    Filter the lab snapshot. Explicit tokens only — a wildcard block is not a named decision.
    Panel <code>{lab.panel_version}</code>, parse {lab.parse_version}.
  </p>
  <Explorer agents={agents} named={named} />
</Layout>
