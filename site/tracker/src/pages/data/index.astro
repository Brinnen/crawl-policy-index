---
import Layout from "../../layouts/Layout.astro";
import { purposeLabel } from "../../lib/labels";
import lab from "../../data/lab.json";

const agents = lab.by_agent ?? [];
---
<Layout
  title="Bots — Crawl Policy Index"
  description="How often each AI crawler is named and blocked on this list of sites."
>
  <div class="page-head">
    <p class="kicker">Bots</p>
    <h1>How often each bot is named and blocked.</h1>
  </div>
  <p class="lede">
    These are sites that named the bot in robots.txt. For country, type of site, and language — including blanket “block all bots” — use Tables.
  </p>
  <section class="panel">
    <div class="table-scroll">
      <table class="data">
        <thead>
          <tr>
            <th>Bot</th>
            <th>Company</th>
            <th>What it’s for</th>
            <th class="num">Blocked</th>
            <th class="num">Allowed</th>
            <th class="num">Mixed</th>
          </tr>
        </thead>
        <tbody data-home-agents>
          {agents.map((row) => (
            <tr>
              <td>{row.token}</td>
              <td>{row.operator}</td>
              <td>{purposeLabel(row.purpose)}</td>
              <td class="num">{row.named_block ?? "—"}</td>
              <td class="num">{row.named_allow ?? "—"}</td>
              <td class="num">{row.named_partial ?? "—"}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Layout>
