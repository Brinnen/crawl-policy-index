---
import Layout from "../../layouts/Layout.astro";
import Explorer from "../../components/Explorer.astro";
import Glossary from "../../components/Glossary.astro";
import lab from "../../data/lab.json";

const agents = lab.by_agent ?? [];
const named = lab.named ?? [];
const blanket = lab.blanket ?? [];
const languages = lab.by_language ?? [];
const countries = lab.by_country ?? [];
const verticals = lab.by_vertical ?? [];
---
<Layout
  title="Explore — Crawl Policy Index"
  description="Look up which websites named which AI bots, and whether they allowed, blocked, or mixed them — including a blanket block-all-bots rule."
>
  <div class="page-head">
    <p class="kicker">Explore</p>
    <h1>Look up a bot or a website.</h1>
  </div>
  <p class="lede">
    Filter bots below. Type a website, or ask a slice: Swedish-language sites, or labeled news in Sweden.
    Language is not country. News is a curated list, not every publisher.
  </p>
  <Explorer
    agents={agents}
    named={named}
    blanket={blanket}
    languages={languages}
    countries={countries}
    verticals={verticals}
  />
  <Glossary />
</Layout>
