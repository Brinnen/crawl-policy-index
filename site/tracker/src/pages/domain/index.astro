---
import Layout from "../../layouts/Layout.astro";
import DomainView from "../../components/DomainView.astro";
import { normalizeDomain } from "../../lib/story";

const q = normalizeDomain(Astro.url.searchParams.get("q") || "");
if (q) return Astro.redirect(`/domain/${encodeURIComponent(q)}`);
---
<Layout
  title="Look up a website — Crawl Policy Index"
  description="Type a website. We'll say in English which AI crawlers it blocks or allows."
>
  <DomainView domain="" />
</Layout>
