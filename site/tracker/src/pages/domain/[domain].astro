---
import Layout from "../../layouts/Layout.astro";
import lab from "../../data/lab.json";

type NamedRow = {
  domain: string;
  state: string;
  valid_from?: string;
  agent_slug?: string;
  token?: string;
  agent?: string;
  operator?: string;
  purpose?: string;
  group_key: string;
};

export function getStaticPaths() {
  const named = lab.named as NamedRow[];
  const byDomain = new Map<string, NamedRow[]>();
  for (const row of named) {
    const list = byDomain.get(row.domain) ?? [];
    list.push(row);
    byDomain.set(row.domain, list);
  }
  return [...byDomain.entries()].map(([domain, rows]) => ({
    params: { domain },
    props: { domain, rows },
  }));
}

interface Props {
  domain: string;
  rows: NamedRow[];
}

const { domain, rows } = Astro.props;
const purpose: Record<string, string> = {
  training: "Training",
  search_index: "Search",
  user_fetch: "User fetch",
  opt_out_token: "Opt-out token",
  agentic: "Agentic",
  unknown: "Unknown",
};
---
<Layout title={`${domain} — Crawl Policy Index`}>
  <div class="page-head">
    <p class="kicker">Domain</p>
    <h1>{domain}</h1>
  </div>
  <section class="panel">
    <h2>Named tokens</h2>
    <p class="sub">Open explicit intervals for this host. Not an effective-policy row.</p>
    <table class="data">
      <thead>
        <tr>
          <th>Agent</th>
          <th>Operator</th>
          <th>Purpose</th>
          <th>State</th>
          <th>From</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            <td class="mono">{row.token ?? row.agent ?? "GPTBot"}</td>
            <td>{row.operator ?? "—"}</td>
            <td>{purpose[row.purpose ?? ""] ?? row.purpose ?? "—"}</td>
            <td class="mono">{row.state}</td>
            <td class="mono">{row.valid_from}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
</Layout>
