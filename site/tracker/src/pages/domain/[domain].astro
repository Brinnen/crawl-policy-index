---
import Layout from "../../layouts/Layout.astro";
import lab from "../../data/lab.json";
import { purposeLabel, STATE_LABELS } from "../../lib/labels";

type NamedRow = {
  domain: string;
  state: string;
  valid_from?: string;
  agent_slug?: string;
  token?: string;
  agent?: string;
  operator?: string;
  purpose?: string;
  group_key: string;
};

export function getStaticPaths() {
  const named = lab.named as NamedRow[];
  const byDomain = new Map<string, NamedRow[]>();
  for (const row of named) {
    const list = byDomain.get(row.domain) ?? [];
    list.push(row);
    byDomain.set(row.domain, list);
  }
  return [...byDomain.entries()].map(([domain, rows]) => ({
    params: { domain },
    props: { domain, rows },
  }));
}

interface Props {
  domain: string;
  rows: NamedRow[];
}

const { domain, rows } = Astro.props;
---
<Layout title={`${domain} — Crawl Policy Index`}>
  <div class="page-head">
    <p class="kicker">Website</p>
    <h1>{domain}</h1>
  </div>
  <section class="panel">
    <h2>Bots this site named</h2>
    <p class="sub">Only rules where this website wrote the bot’s name. A blanket “block everyone” rule is not listed.</p>
    <table class="data">
      <thead>
        <tr>
          <th>Bot</th>
          <th>Company</th>
          <th>What it’s for</th>
          <th>What they said</th>
          <th>Since</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            <td>{row.token ?? row.agent ?? "GPTBot"}</td>
            <td>{row.operator ?? "—"}</td>
            <td>{purposeLabel(row.purpose)}</td>
            <td>{STATE_LABELS[row.state] ?? row.state}</td>
            <td>{row.valid_from}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
</Layout>
