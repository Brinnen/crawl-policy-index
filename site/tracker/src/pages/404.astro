---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Page not found — Crawl Policy Index">
  <div class="page-head">
    <p class="kicker">Missing page</p>
    <h1>We can’t find that page.</h1>
  </div>
  <p class="lede">It may have moved. The overview, the tables, and how we count are all still here.</p>
  <div class="hero-actions">
    <a class="btn btn-primary" href="/">Back to the overview</a>
    <a class="btn btn-ghost" href="/data">Browse the tables</a>
  </div>
</Layout>
