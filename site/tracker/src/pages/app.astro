---
import Layout from "../layouts/Layout.astro";
import MarketTable from "../components/MarketTable.astro";
import { HISTORY_PRICE_LABEL, isHistory, isSubscribed } from "../lib/access";
import { userIdFromLocals } from "../lib/clerk";
import lab from "../data/lab.json";

const userId = userIdFromLocals(Astro.locals);
if (!userId) return Astro.redirect("/sign-in");

let user: { publicMetadata?: Record<string, unknown> } | null = null;
try {
  user = (await Astro.locals.currentUser?.()) ?? null;
} catch {
  user = null;
}
if (!isSubscribed(user)) return Astro.redirect("/pricing");

const agents = lab.by_agent ?? [];
---
<Layout
  title="Full table — Crawl Policy Index"
  description="Filter the full list of sites by country, type, language, and bot."
>
  <div class="page-head">
    <p class="kicker">Full table</p>
    <h1>Filter the list. Get the number.</h1>
  </div>
  <p class="lede">
    Country, type of site, language, and bot. The figure is how many of those sites block it.
  </p>
  {!isHistory(user) && (
    <div class="paywall-band">
      <p>Want to see who flipped? History is the change log — who blocked, who unblocked, and when.</p>
      <a class="btn btn-primary" href="/pricing#history">Add history · {HISTORY_PRICE_LABEL}</a>
    </div>
  )}
  <section class="panel">
    <MarketTable agents={agents} mode="full" />
  </section>
</Layout>
