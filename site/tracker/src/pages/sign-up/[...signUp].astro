---
import Layout from "../../layouts/Layout.astro";
import { SignUp } from "@clerk/astro/components";
import { CLERK_ENABLED } from "../../lib/clerk";
---
<Layout title="Create an account — Crawl Policy Index" description="Create an account to subscribe.">
  <div class="auth-box">
    {CLERK_ENABLED ? (
      <SignUp path="/sign-up" fallbackRedirectUrl="/api/checkout" />
    ) : (
      <p class="lede">Accounts are not live on this deploy yet. The sample table is free on the homepage.</p>
    )}
  </div>
</Layout>
