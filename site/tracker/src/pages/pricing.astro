---
import Layout from "../layouts/Layout.astro";
import { HISTORY_PRICE_LABEL, PRICE_LABEL } from "../lib/access";
import lab from "../data/lab.json";

const panel = Number(lab.summary.panel_size || 100000).toLocaleString("en-US");
---
<Layout
  title="Subscribe — Crawl Policy Index"
  description="Subscribe for the full filterable table, or add history of who blocked and unblocked AI crawlers."
>
  <div class="page-head">
    <p class="kicker">Pricing</p>
    <h1>The stories are free. The full list is for people who need the number.</h1>
  </div>
  <p class="lede">
    Anyone can look up a website. Subscribers get the whole {panel}-site table, the filters,
    and a file. History subscribers also get every flip we recorded.
  </p>
  <section class="pricing-grid">
    <article class="pricing-card">
      <p class="kicker">Full table</p>
      <p class="price">{PRICE_LABEL}</p>
      <ul>
        <li>Look up any of {panel} websites, plus the full filterable table</li>
        <li>Filter by country, type of site, language, and bot</li>
        <li>Download today's table as CSV</li>
        <li>Updated from the daily crawl</li>
      </ul>
      <a class="btn btn-primary" href="/api/checkout?plan=table">Subscribe today</a>
      <p class="instrument-sub">Create an account, then pay with Stripe. Cancel from your account.</p>
    </article>
    <article class="pricing-card pricing-card-featured" id="history">
      <p class="kicker">History</p>
      <p class="price">{HISTORY_PRICE_LABEL}</p>
      <ul>
        <li>Everything in the full table</li>
        <li>Who blocked or unblocked a bot, and when</li>
        <li>Filter the change log by bot and website</li>
        <li>The same daily crawl, plus the archive</li>
      </ul>
      <a class="btn btn-primary" href="/api/checkout?plan=history">Subscribe with history</a>
      <p class="instrument-sub">Includes the live table. Same Stripe checkout.</p>
    </article>
  </section>
</Layout>
