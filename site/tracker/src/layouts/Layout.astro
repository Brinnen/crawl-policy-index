---
import "@fontsource-variable/plus-jakarta-sans";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import { Show, SignInButton, UserButton } from "@clerk/astro/components";
import "../styles/global.css";
import lab from "../data/lab.json";

interface Props {
  title: string;
  description?: string;
}

const panelSize = Number(lab.summary.panel_size || 1000);
const panelLabel = panelSize.toLocaleString("en-US");

const {
  title,
  description = "See which websites block AI crawlers, by country, type of site, and language.",
} = Astro.props;

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const nav = [
  { href: "/#sample", label: "Sample" },
  { href: "/pricing", label: "Pricing" },
  { href: "/bot", label: "Site owners" },
];

function isActive(href: string) {
  if (href === "/#sample") return path === "/";
  return path === href || path.startsWith(`${href}/`);
}

const exportedDate = new Date(lab.generated_at).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#07080c" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="shell">
      <div class="notice">
        <div class="wrap">
          A daily table of who blocks which AI crawler · <span data-panel-size>{panelLabel}</span> sites
        </div>
      </div>
      <header class="topbar">
        <div class="wrap topbar-inner">
          <a class="brand" href="/">
            <span class="mark" aria-hidden="true">
              <svg viewBox="0 0 16 16" fill="none">
                <path d="M3 3.5h10M3 8h7M3 12.5h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                <circle cx="12.2" cy="8" r="1.6" fill="currentColor"/>
              </svg>
            </span>
            <span class="brand-name">Crawl Policy <span>Index</span></span>
          </a>
          <nav class="primary" aria-label="Primary">
            {nav.map((item) => (
              <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            ))}
            <Show when="signed-out">
              <SignInButton mode="redirect" class="nav-text">Sign in</SignInButton>
              <a class="btn btn-primary btn-nav" href="/sign-up">Subscribe</a>
            </Show>
            <Show when="signed-in">
              <a href="/app">Full table</a>
              <UserButton />
            </Show>
          </nav>
        </div>
      </header>
      <main>
        <div class="wrap">
          <slot />
        </div>
      </main>
      <footer class="site-footer">
        <div class="wrap">
          <span>Snapshot <span data-exported-date>{exportedDate}</span> · <span data-panel-size>{panelLabel}</span> sites</span>
          <span><a href="/methodology">How we count</a> · <a href="/bot">If we visited your website</a></span>
        </div>
      </footer>
    </div>
    <script>
      import { SNAPSHOT_URL, bootLiveLab } from "../scripts/live-lab";
      bootLiveLab(SNAPSHOT_URL);
    </script>
  </body>
</html>
