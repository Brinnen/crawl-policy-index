---
import LookupForm from "./LookupForm.astro";
import SiteCard from "./SiteCard.astro";
import { PRICE_LABEL } from "../lib/access";
import { loadSiteView } from "../lib/lookupPack";
import { normalizeDomain } from "../lib/story";

interface Props {
  domain: string;
}

const { domain: raw } = Astro.props;
const domain = normalizeDomain(raw);
const view = domain ? await loadSiteView(domain) : null;
---
<div class="page-head">
  <p class="kicker">Look up</p>
  <h1>{view ? view.domain : domain || "Pick a website"}</h1>
</div>

{!domain && (
  <p class="lede">Type a website on the list we watch. We'll say what it told the crawlers.</p>
)}

<LookupForm value={domain} autofocus={!domain} />

{domain && view && (
  <section class="panel story-panel">
    <SiteCard view={view} />
  </section>
)}

{domain && !view && (
  <section class="panel">
    <h2>{domain} is not on this list.</h2>
    <p class="sub">
      We watch a pinned 100,000 websites, not the whole web. Try wikipedia.org, svt.se, or a shop
      you already know.
    </p>
  </section>
)}

<div class="paywall-band">
  <p>Want every site on the list, filters, and a file of today's table?</p>
  <a class="btn btn-primary" href="/pricing">Subscribe · {PRICE_LABEL}</a>
</div>
