---
interface Props {
  block: number;
  allow: number;
  partial: number;
}
const { block, allow, partial } = Astro.props;
const realTotal = block + allow + partial;
const total = Math.max(realTotal, 1);
const w = 920;
const h = 56;
const y = 14;
const barH = 28;
const segs = [
  { n: block, color: "var(--block)" },
  { n: allow, color: "var(--allow)" },
  { n: partial, color: "var(--partial)" },
];
let cursor = 0;
const rects = segs.map((seg) => {
  const width = realTotal === 0 ? 0 : (seg.n / total) * w;
  const rect = { x: cursor, width, color: seg.color, n: seg.n };
  cursor += width;
  return rect;
});
function pct(n: number) {
  if (realTotal === 0) return "0%";
  return `${Math.round((n / realTotal) * 100)}%`;
}
---
<svg class="chart" viewBox={`0 0 ${w} ${h}`} role="img" aria-label="Among sites that named GPTBot: how many blocked, allowed, or mixed it">
  <defs>
    <clipPath id="cpi-bar">
      <rect x="0" y={y} width={w} height={barH} rx="14" />
    </clipPath>
  </defs>
  <rect x="0" y={y} width={w} height={barH} rx="14" fill="var(--line)" />
  <g clip-path="url(#cpi-bar)">
    {rects.map((rect) =>
      rect.width > 0 ? (
        <rect x={rect.x} y={y} width={rect.width} height={barH} fill={rect.color} />
      ) : null,
    )}
  </g>
</svg>
<div class="legend">
  <span><i class="swatch" style="background:var(--block)"></i>Blocked {block} · {pct(block)}</span>
  <span><i class="swatch" style="background:var(--allow)"></i>Allowed {allow} · {pct(allow)}</span>
  <span><i class="swatch" style="background:var(--partial)"></i>Mixed {partial} · {pct(partial)}</span>
</div>
