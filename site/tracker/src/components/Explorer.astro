---
import { PURPOSE_LABELS, STATE_LABELS, LANGUAGE_LABELS, COUNTRY_LABELS, VERTICAL_LABELS, purposeLabel } from "../lib/labels";

interface AgentRow {
  slug: string;
  token: string;
  agent: string;
  operator: string;
  purpose: string;
  named_block: number | null;
  named_allow: number | null;
  named_partial: number | null;
}

interface NamedRow {
  domain: string;
  state: string;
  valid_from?: string;
  agent_slug?: string;
  token?: string;
  agent?: string;
  operator?: string;
  purpose?: string;
  kind?: string;
  group_key: string;
}

interface SliceRow {
  language?: string;
  country?: string;
  vertical?: string;
  sites: number;
}

interface Props {
  agents: AgentRow[];
  named: NamedRow[];
  blanket: NamedRow[];
  languages?: SliceRow[];
  countries?: SliceRow[];
  verticals?: SliceRow[];
}

const { agents, named, blanket, languages = [], countries = [], verticals = [] } = Astro.props;

const operators = [...new Set(agents.map((a) => a.operator))].sort();
const purposes = [...new Set(agents.map((a) => a.purpose))].sort();
const tokens = [...agents].sort((a, b) => a.token.localeCompare(b.token));

const payload = JSON.stringify({
  agents,
  named,
  blanket,
  languages,
  countries,
  verticals,
  purposeLabels: PURPOSE_LABELS,
  stateLabels: STATE_LABELS,
  languageLabels: LANGUAGE_LABELS,
  countryLabels: COUNTRY_LABELS,
  verticalLabels: VERTICAL_LABELS,
}).replaceAll("<", "\\u003c");
---
<div class="explorer" id="cpi-explorer">
  <section class="panel">
    <h2>By bot</h2>
    <p class="sub">How many sites named each bot — plus the site-wide “block all bots” rule, which is a policy of its own. An opt-out signal is not a crawler.</p>
    <div class="filters filters-3">
      <label class="field">
        <span>Company</span>
        <select data-filter="agent-operator">
          <option value="">All companies</option>
          {operators.map((op) => <option value={op}>{op}</option>)}
        </select>
      </label>
      <label class="field">
        <span>What it’s for</span>
        <select data-filter="agent-purpose">
          <option value="">All uses</option>
          {purposes.map((p) => <option value={p}>{purposeLabel(p)}</option>)}
        </select>
      </label>
      <label class="field">
        <span>Find a bot</span>
        <input type="search" data-filter="agent-q" placeholder="GPTBot, Claude, OpenAI…" autocomplete="off" />
      </label>
    </div>
    <p class="explorer-meta"><span data-agent-count></span></p>
    <div class="table-scroll">
      <table class="data" data-agent-table>
        <thead>
          <tr>
            <th>Bot</th>
            <th>Company</th>
            <th>What it’s for</th>
            <th class="num">Blocked</th>
            <th class="num">Allowed</th>
            <th class="num">Mixed</th>
          </tr>
        </thead>
        <tbody data-agent-body></tbody>
      </table>
    </div>
  </section>

  <section class="panel">
    <h2>By website</h2>
    <p class="sub">Type a website, or filter by language, labeled country, or news. Language is what the homepage declared — not the country. Country and news are only set where we labeled them.</p>
    <div class="filters">
      <label class="field">
        <span>Website</span>
        <input type="search" data-filter="domain-q" placeholder="amazon.com or nytimes" autocomplete="off" />
      </label>
      <label class="field">
        <span>Bot</span>
        <select data-filter="domain-agent">
          <option value="">All bots</option>
          {tokens.map((a) => <option value={a.slug}>{a.token}</option>)}
        </select>
      </label>
      <label class="field">
        <span>What the site said</span>
        <select data-filter="domain-state">
          <option value="">Any answer</option>
          <option value="BLOCKED">Blocked</option>
          <option value="ALLOWED">Allowed</option>
          <option value="PARTIAL">Mixed</option>
        </select>
      </label>
      <label class="field">
        <span>What it’s for</span>
        <select data-filter="domain-purpose">
          <option value="">All uses</option>
          {purposes.map((p) => <option value={p}>{purposeLabel(p)}</option>)}
        </select>
      </label>
      <label class="field">
        <span>Language</span>
        <select data-filter="domain-language">
          <option value="">Any language</option>
          <option value="unknown">Unknown</option>
        </select>
      </label>
      <label class="field">
        <span>Country (labeled)</span>
        <select data-filter="domain-country">
          <option value="">Any labeled country</option>
        </select>
      </label>
      <label class="field">
        <span>Category (labeled)</span>
        <select data-filter="domain-vertical">
          <option value="">Any category</option>
          <option value="news">News</option>
        </select>
      </label>
    </div>
    <label class="check">
      <input type="checkbox" data-filter="collapse-amazon" />
      Count Amazon’s country sites as one company
    </label>
    <p class="explorer-meta"><span data-domain-count></span></p>
    <div class="table-scroll">
      <table class="data" data-domain-table>
        <thead>
          <tr>
            <th>Website</th>
            <th>Bot</th>
            <th>Company</th>
            <th>What it’s for</th>
            <th>What they said</th>
          </tr>
        </thead>
        <tbody data-domain-body></tbody>
      </table>
    </div>
  </section>
</div>
<script id="cpi-explorer-data" type="application/json" set:html={payload}></script>
<script>
  const root = document.getElementById("cpi-explorer");
  const raw = document.getElementById("cpi-explorer-data");
  if (root && raw) {
    const data = JSON.parse(raw.textContent || '{"agents":[],"named":[],"blanket":[],"purposeLabels":{},"stateLabels":{}}');
    let agents = data.agents || [];
    let named = data.named || [];
    let blanket = data.blanket || [];
    const PURPOSE = data.purposeLabels || {};
    const STATE = data.stateLabels || {};
    const LANG = data.languageLabels || {};
    const COUNTRY = data.countryLabels || {};
    const VERTICAL = data.verticalLabels || {};
    const $ = (sel: string) => root.querySelector(sel) as HTMLInputElement | HTMLSelectElement;
    const agentBody = root.querySelector("[data-agent-body]") as HTMLElement;
    const domainBody = root.querySelector("[data-domain-body]") as HTMLElement;
    const agentCount = root.querySelector("[data-agent-count]") as HTMLElement;
    const domainCount = root.querySelector("[data-domain-count]") as HTMLElement;
    const LOOKUP_URL = "/snapshot/lookup.json";
    const MAX_DOMAIN_ROWS = 250;
    let lookupPromise: Promise<void> | null = null;
    let lookupLoaded = false;
    let namedTriples: [string, string, string][] = [];
    let blanketTriples: [string, string][] = [];
    let siteMeta: Record<string, { language: string; country: string; vertical: string }> = {};

    function rebuildMeta() {
      agentMeta = {};
      for (const a of agents) {
        agentMeta[a.slug] = { token: a.token, agent: a.agent, operator: a.operator, purpose: a.purpose };
      }
    }
    rebuildMeta();

    function groupKey(domain: string) {
      const host = domain.toLowerCase().replace(/\.$/, "");
      if (host === "amazon.com" || host.startsWith("amazon.")) return "amazon.com";
      return host;
    }
    function hydrateNamed(domain: string, slug: string, state: string) {
      const m = agentMeta[slug];
      return {
        domain,
        agent_slug: slug,
        state,
        kind: "named",
        token: m?.token || slug,
        agent: m?.agent || slug,
        operator: m?.operator || "—",
        purpose: m?.purpose,
        group_key: groupKey(domain),
      };
    }
    function hydrateBlanket(domain: string, state: string) {
      return {
        domain,
        state,
        kind: "blanket",
        agent_slug: "wildcard-star",
        token: "All bots (*)",
        agent: "All bots",
        operator: "Site-wide rule",
        purpose: "blanket",
        group_key: groupKey(domain),
      };
    }
    function ingestSites(rows: [string, string, string, string][] | undefined) {
      if (!rows) return;
      for (const [domain, language, country, vertical] of rows) {
        siteMeta[domain] = {
          language: language || "",
          country: (country || "").toUpperCase(),
          vertical: vertical || "other",
        };
      }
    }
    function siteOf(domain: string) {
      return siteMeta[domain] || { language: "", country: "", vertical: "other" };
    }
    function fillSliceFilters() {
      const langSel = $('[data-filter="domain-language"]') as HTMLSelectElement;
      const countrySel = $('[data-filter="domain-country"]') as HTMLSelectElement;
      const vertSel = $('[data-filter="domain-vertical"]') as HTMLSelectElement;
      const langs = uniqueSorted(Object.values(siteMeta).map((s) => s.language).filter(Boolean));
      const countries = uniqueSorted(Object.values(siteMeta).map((s) => s.country).filter(Boolean));
      const verts = uniqueSorted(Object.values(siteMeta).map((s) => s.vertical).filter((v) => v && v !== "other"));
      fillSelect(
        langSel,
        [{ value: "unknown", label: "Unknown" }, ...langs.map((code) => ({ value: code, label: LANG[code] || code }))],
        "Any language",
      );
      fillSelect(
        countrySel,
        countries.map((code) => ({ value: code, label: COUNTRY[code] || code })),
        "Any labeled country",
      );
      fillSelect(
        vertSel,
        verts.map((v) => ({ value: v, label: VERTICAL[v] || v })),
        "Any category",
      );
    }
    function ensureLookup() {
      if (lookupLoaded) return Promise.resolve();
      if (!lookupPromise) {
        lookupPromise = fetch(LOOKUP_URL, { cache: "no-store" })
          .then((res) => {
            if (!res.ok) throw new Error(String(res.status));
            return res.json() as Promise<{
              named?: [string, string, string][];
              blanket?: [string, string][];
              sites?: [string, string, string, string][];
            }>;
          })
          .then((pack) => {
            if (!named.length && !blanket.length) {
              namedTriples = pack.named || [];
              blanketTriples = pack.blanket || [];
            }
            ingestSites(pack.sites);
            lookupLoaded = true;
            fillSliceFilters();
          });
      }
      return lookupPromise;
    }

    function num(n: number | null | undefined) {
      if (n === null || n === undefined) return "—";
      return new Intl.NumberFormat("en-US").format(n);
    }
    function esc(value: string) {
      return value.replace(/[&<>"']/g, (ch) => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
      })[ch] || ch);
    }
    function purpose(value: string | undefined) {
      return PURPOSE[value || ""] || value || "—";
    }
    function badge(row: { state: string; kind?: string; purpose?: string }) {
      if (row.kind === "blanket" || row.purpose === "blanket") {
        return `<span class="badge badge-blanket">Block all bots</span>`;
      }
      const cls = row.state === "BLOCKED" ? "block" : row.state === "ALLOWED" ? "allow" : "partial";
      return `<span class="badge badge-${cls}">${esc(STATE[row.state] || row.state)}</span>`;
    }
    function applyUrl() {
      const params = new URLSearchParams(location.search);
      const map: Record<string, string> = {
        operator: "agent-operator",
        purpose: "agent-purpose",
        aq: "agent-q",
        q: "domain-q",
        agent: "domain-agent",
        state: "domain-state",
        dpurpose: "domain-purpose",
        lang: "domain-language",
        country: "domain-country",
        vertical: "domain-vertical",
      };
      for (const [key, attr] of Object.entries(map)) {
        const el = root!.querySelector(`[data-filter="${attr}"]`) as HTMLInputElement | HTMLSelectElement | null;
        if (el && params.has(key)) el.value = params.get(key) || "";
      }
      const collapse = root!.querySelector('[data-filter="collapse-amazon"]') as HTMLInputElement | null;
      if (collapse) collapse.checked = params.get("collapse") === "1";
    }
    function writeUrl() {
      const u = new URL(location.href);
      const set = (key: string, attr: string) => {
        const el = root!.querySelector(`[data-filter="${attr}"]`) as HTMLInputElement | HTMLSelectElement | null;
        const v = el?.value.trim() || "";
        if (v) u.searchParams.set(key, v);
        else u.searchParams.delete(key);
      };
      set("operator", "agent-operator");
      set("purpose", "agent-purpose");
      set("aq", "agent-q");
      set("q", "domain-q");
      set("agent", "domain-agent");
      set("state", "domain-state");
      set("dpurpose", "domain-purpose");
      set("lang", "domain-language");
      set("country", "domain-country");
      set("vertical", "domain-vertical");
      const collapse = root!.querySelector('[data-filter="collapse-amazon"]') as HTMLInputElement | null;
      if (collapse?.checked) u.searchParams.set("collapse", "1");
      else u.searchParams.delete("collapse");
      history.replaceState(null, "", u);
    }
    function renderAgents() {
      const op = $('[data-filter="agent-operator"]').value;
      const purposeFilter = $('[data-filter="agent-purpose"]').value;
      const q = $('[data-filter="agent-q"]').value.trim().toLowerCase();
      const rows = agents.filter((a: { operator: string; purpose: string; token: string; agent: string; slug: string; named_block: number | null; named_allow: number | null; named_partial: number | null }) => {
        if (op && a.operator !== op) return false;
        if (purposeFilter && a.purpose !== purposeFilter) return false;
        if (q && ![a.token, a.agent, a.operator, a.slug].join(" ").toLowerCase().includes(q)) return false;
        return true;
      });
      agentCount.textContent = `Showing ${rows.length} of ${agents.length} bots`;
      agentBody.innerHTML = rows
        .map(
          (a: { slug: string; token: string; operator: string; purpose: string; named_block: number | null; named_allow: number | null; named_partial: number | null }) =>
            `<tr>
              <td><a href="/data?agent=${encodeURIComponent(a.slug)}">${esc(a.token)}</a></td>
              <td>${esc(a.operator)}</td>
              <td>${esc(purpose(a.purpose))}</td>
              <td class="num">${num(a.named_block)}</td>
              <td class="num">${num(a.named_allow)}</td>
              <td class="num">${num(a.named_partial)}</td>
            </tr>`,
        )
        .join("");
    }
    function renderDomains() {
      const q = $('[data-filter="domain-q"]').value.trim().toLowerCase();
      const lang = $('[data-filter="domain-language"]').value;
      const country = $('[data-filter="domain-country"]').value;
      const vertical = $('[data-filter="domain-vertical"]').value;
      const sliced = Boolean(lang || country || vertical);
      const hasBakedRows = named.length > 0 || blanket.length > 0;
      if (!hasBakedRows && !lookupLoaded && q.length < 2 && !sliced) {
        domainCount.textContent = "Type a website, or pick language / news / a labeled country.";
        domainBody.innerHTML =
          `<tr><td colspan="5" class="empty-cell">Website rows load when you search or filter. Language is not country. News is only the labeled list.</td></tr>`;
        return;
      }
      if (!lookupLoaded && (!hasBakedRows || sliced)) {
        domainCount.textContent = "Looking up…";
        domainBody.innerHTML = `<tr><td colspan="5" class="empty-cell">Looking up websites…</td></tr>`;
        ensureLookup()
          .then(() => paintDomains())
          .catch(() => {
            domainCount.textContent = "Website lookup is not available yet.";
            domainBody.innerHTML =
              `<tr><td colspan="5" class="empty-cell">Could not load website rows. Try again in a minute.</td></tr>`;
          });
        return;
      }
      paintDomains();
    }
    function gptbotNamedDomains() {
      const out = new Set<string>();
      if (namedTriples.length) {
        for (const [domain, slug] of namedTriples) {
          if (slug === "openai-gptbot") out.add(domain);
        }
        return out;
      }
      for (const r of named) {
        if (r.agent_slug === "openai-gptbot") out.add(r.domain);
      }
      return out;
    }
    function paintDomains() {
      const q = $('[data-filter="domain-q"]').value.trim().toLowerCase();
      const agent = $('[data-filter="domain-agent"]').value;
      const state = $('[data-filter="domain-state"]').value;
      const purposeFilter = $('[data-filter="domain-purpose"]').value;
      const langFilter = $('[data-filter="domain-language"]').value;
      const countryFilter = $('[data-filter="domain-country"]').value;
      const verticalFilter = $('[data-filter="domain-vertical"]').value;
      const collapse = (root!.querySelector('[data-filter="collapse-amazon"]') as HTMLInputElement).checked;
      const namedGpt = agent === "openai-gptbot" ? gptbotNamedDomains() : null;
      const seen = new Set<string>();
      const shown: ReturnType<typeof hydrateNamed>[] = [];
      let total = 0;

      function consider(row: ReturnType<typeof hydrateNamed>) {
        if (q && !row.domain.toLowerCase().includes(q) && !(row.group_key || "").toLowerCase().includes(q)) return;
        if (agent === "openai-gptbot") {
          const namedHit = row.agent_slug === "openai-gptbot";
          const inherited = row.kind === "blanket" && namedGpt != null && !namedGpt.has(row.domain);
          if (!namedHit && !inherited) return;
        } else if (agent && row.agent_slug !== agent) {
          return;
        }
        if (state && row.state !== state) return;
        if (purposeFilter && row.purpose !== purposeFilter) return;
        const site = siteOf(row.domain);
        if (langFilter === "unknown" && site.language) return;
        if (langFilter && langFilter !== "unknown" && site.language !== langFilter) return;
        if (countryFilter && site.country !== countryFilter) return;
        if (verticalFilter && site.vertical !== verticalFilter) return;
        if (collapse) {
          const key = `${row.group_key}|${row.agent_slug || row.token}|${row.state}`;
          if (seen.has(key)) return;
          seen.add(key);
        }
        total += 1;
        if (shown.length < MAX_DOMAIN_ROWS) shown.push(row);
      }

      if (namedTriples.length || blanketTriples.length) {
        for (const [domain, slug, rowState] of namedTriples) consider(hydrateNamed(domain, slug, rowState));
        for (const [domain, rowState] of blanketTriples) consider(hydrateBlanket(domain, rowState));
      } else {
        for (const r of named) {
          consider({
            domain: r.domain,
            agent_slug: r.agent_slug || "openai-gptbot",
            state: r.state,
            kind: r.kind || "named",
            token: r.token || r.agent || "GPTBot",
            agent: r.agent || r.token || "GPTBot",
            operator: r.operator || "—",
            purpose: r.purpose,
            group_key: r.group_key || groupKey(r.domain),
          });
        }
        for (const r of blanket) consider(hydrateBlanket(r.domain, r.state));
      }
      domainCount.textContent =
        total > MAX_DOMAIN_ROWS
          ? `Showing ${shown.length} of ${total} matching website rules. Type more of the name to narrow it.`
          : `Showing ${total} website rule${total === 1 ? "" : "s"}`;
      if (shown.length === 0) {
        domainBody.innerHTML = `<tr><td colspan="5" class="empty-cell">Nothing matches. Try a shorter name, or All bots.</td></tr>`;
        return;
      }
      domainBody.innerHTML = shown
        .map(
          (r) =>
            `<tr>
              <td><a href="/domain/${encodeURIComponent(r.domain)}">${esc(r.domain)}</a></td>
              <td>${esc(r.token || r.agent || "GPTBot")}</td>
              <td>${esc(r.operator || "—")}</td>
              <td>${esc(purpose(r.purpose))}</td>
              <td>${badge(r)}</td>
            </tr>`,
        )
        .join("");
    }
    function uniqueSorted(values: string[]) {
      return [...new Set(values.filter(Boolean))].sort();
    }
    function fillSelect(sel: HTMLSelectElement, values: { value: string; label: string }[], blank: string) {
      const current = sel.value;
      sel.innerHTML =
        `<option value="">${esc(blank)}</option>` +
        values.map((v) => `<option value="${esc(v.value)}">${esc(v.label)}</option>`).join("");
      if ([...sel.options].some((o) => o.value === current)) sel.value = current;
    }
    function syncFilters() {
      const opSel = $('[data-filter="agent-operator"]') as HTMLSelectElement;
      const purposeSel = $('[data-filter="agent-purpose"]') as HTMLSelectElement;
      const dPurposeSel = $('[data-filter="domain-purpose"]') as HTMLSelectElement;
      const agentSel = $('[data-filter="domain-agent"]') as HTMLSelectElement;
      fillSelect(
        opSel,
        uniqueSorted(agents.map((a: { operator: string }) => a.operator)).map((op) => ({ value: op, label: op })),
        "All companies",
      );
      const purposes = uniqueSorted(agents.map((a: { purpose: string }) => a.purpose));
      fillSelect(
        purposeSel,
        purposes.map((p) => ({ value: p, label: purpose(p) })),
        "All uses",
      );
      fillSelect(
        dPurposeSel,
        purposes.map((p) => ({ value: p, label: purpose(p) })),
        "All uses",
      );
      const tokens = [...agents].sort((a: { token: string }, b: { token: string }) => a.token.localeCompare(b.token));
      fillSelect(
        agentSel,
        tokens.map((a: { slug: string; token: string }) => ({ value: a.slug, label: a.token })),
        "All bots",
      );
    }
    function render() {
      renderAgents();
      renderDomains();
      writeUrl();
    }
    window.addEventListener("cpi-lab", (event) => {
      const lab = (event as CustomEvent).detail;
      if (!lab) return;
      agents = lab.by_agent || agents;
      rebuildMeta();
      if (lab.named && lab.named.length) named = lab.named;
      if (lab.blanket && lab.blanket.length) blanket = lab.blanket;
      syncFilters();
      render();
    });
    if (window.__CPI_LAB) {
      const live = window.__CPI_LAB;
      agents = live.by_agent || agents;
      rebuildMeta();
      if (live.named && live.named.length) named = live.named;
      if (live.blanket && live.blanket.length) blanket = live.blanket;
      syncFilters();
    }
    applyUrl();
    root.querySelectorAll("[data-filter]").forEach((el) => {
      el.addEventListener("input", render);
      el.addEventListener("change", render);
    });
    root.addEventListener("click", (event) => {
      const a = (event.target as HTMLElement).closest("a[href^='/data?agent=']");
      if (!a) return;
      event.preventDefault();
      const slug = new URL((a as HTMLAnchorElement).href).searchParams.get("agent") || "";
      ($('[data-filter="domain-agent"]') as HTMLSelectElement).value = slug;
      render();
      domainBody.scrollIntoView({ behavior: "smooth", block: "start" });
    });
    render();
  }
</script>
